document.getElementById('lyappwindow').style.overflow='auto';

const content = `<meta name="description" content="Zhubuntu Markdown reader">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=0.25, viewport-fit=cover, interactive-widget=overlays-content">
<meta charset="UTF-8">
<meta name="screen-orientation" content="portrait">
<meta name="x5-orientation" content="portrait">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="mobile-web-app-capable" content="yes">

<div style="position:absolute;top:0;left:0;right:0;bottom:0;box-sizing:border-box;padding:16px;overflow:auto;" id="readArea">
Poetry Ready — loading…
</div>`;

runInWindow(content, 'Poetry Ready');

let innerFilePath = '';

function cleanPathStr(s) {
    return (s || '').replace(/[\r\n\t\v\f\u00A0\u2000‑\u200D]+/g, "").trim();
}

function safeMarkdownRender(mdText) {
    if (!window.marked || !window.DOMPurify) {
        showAlert('Please check your Markdown engine');
    }
    const html = marked.parse(mdText || "");
    return DOMPurify.sanitize(html, {
        FORBID_ATTR: ["style","onclick","onerror","onload","onmouseover","onmouseout","onpointerover","onpointerout","onfocus","onblur","onscroll","formaction","xlink:href"],
        REMOVE_TAGS: ["script","iframe","svg","noscript","frameset","frame"],
        ALLOWED_PROTOCOLS: ["http","https","mailto"],
        DISABLE_DATA_ATTR: true
    });
}

window.initPoetryReady = function initPoetryReady() {
    const readArea = document.getElementById('readArea');
    if (!readArea) {
        console.warn("DOM还没准备好，重试 initPoetryReady");
        setTimeout(initPoetryReady, 100);
        return;
    }

    // 读取启动缓存（只存一条纯路径）
    dbGet('/tmp/poetryReady/fileOpen.cache', (rawCache) => {
        const cachePath = cleanPathStr(rawCache);

        if (!cachePath) {
            console.log("没有有效的打开缓存");
            readArea.innerHTML = "<p>Open your .md file through File Manager</p>";
            return;
        }

        console.log("缓存读到路径：", cachePath);
        innerFilePath = cachePath;
        readArea.innerHTML = `<p>Loading <code>${innerFilePath}</code></p>`;

        dbGet(innerFilePath, (fileContent) => {
            if (fileContent === null || fileContent === undefined) {
                readArea.innerHTML = `<p style="color:red">❌文件不存在或为空：<code>${innerFilePath}</code></p>`;
                showAlert(`无法读取：${innerFilePath}`);
            } else {
                readArea.innerHTML = safeMarkdownRender(fileContent);
                console.log("✅文档加载完成", innerFilePath);
            }

            // 和 Zedit 完全一致：读完立刻清空缓存，防止二次复载
        });
    });
};

// 延迟启动初始化，对齐 Zedit 的 150ms
setTimeout(initPoetryReady, 150);

window.quitApp = function quitApp() {

    winEl.style.display = 'none';
    appListEl.style.display = 'block';
    winEl.style.width = '85vw';
    winEl.style.left = '15vw';

